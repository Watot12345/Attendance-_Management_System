# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lams_db
DB_USER=lams_app
DB_PASS=your_secure_password_here
DB_CHARSET=utf8mb4

# SMTP Configuration (for parent alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_or_smtp_password
SMTP_ENCRYPTION=tls
SMTP_FROM_NAME="Library Attendance System"
SMTP_FROM_EMAIL=noreply@library.edu

# Application Settings
APP_ENV=development
APP_URL=http://localhost/lams
APP_NAME="Library Attendance Monitoring System"
APP_TIMEZONE=Asia/Manila

# Security
SESSION_SECRET=change_this_to_a_random_32_character_string
SESSION_LIFETIME=28800

# Feature Flags
AUTO_ABSENCE_ENABLED=true
ALERT_TARDY_ENABLED=true
ALERT_ABSENT_ENABLED=true
ALERT_PERFECT_ATTENDANCE_ENABLED=true

# Limits
CSV_MAX_ROWS=10000
MAX_EXCUSE_DAYS=30
MAX_UPLOAD_SIZE_MB=5
